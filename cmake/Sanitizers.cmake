set(FORGE_SANITIZER "none" CACHE STRING "Instrumentation: none, address, or thread")
set_property(CACHE FORGE_SANITIZER PROPERTY STRINGS none address thread)
set(FORGE_TEST_CC "${CMAKE_C_COMPILER}")
set(FORGE_INSTRUMENT_FLAGS "")
if(NOT FORGE_SANITIZER STREQUAL "none")
    if(NOT UNIX OR NOT CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        message(FATAL_ERROR "Forge sanitizer audits require a UNIX GCC/Clang toolchain")
    endif()
    if(FORGE_SANITIZER STREQUAL "address")
        set(FORGE_INSTRUMENT_FLAGS -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g)
        add_compile_definitions(FORGE_SANITIZER_ADDRESS=1)
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            list(APPEND FORGE_INSTRUMENT_FLAGS -fno-pie -no-pie)
            add_compile_definitions(FORGE_SANITIZER_NONPIE=1)
        endif()
    elseif(FORGE_SANITIZER STREQUAL "thread")
        set(FORGE_INSTRUMENT_FLAGS -fsanitize=thread -fno-omit-frame-pointer -g)
        add_compile_definitions(FORGE_SANITIZER_THREAD=1)
    else()
        message(FATAL_ERROR "Unknown FORGE_SANITIZER: ${FORGE_SANITIZER}")
    endif()
    add_compile_options(${FORGE_INSTRUMENT_FLAGS})
    add_link_options(${FORGE_INSTRUMENT_FLAGS})
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(instrument_arguments "")
    foreach(flag IN LISTS FORGE_INSTRUMENT_FLAGS)
        string(APPEND instrument_arguments "'${flag}',")
    endforeach()
    configure_file(cmake/instrumented-cc.py.in "${CMAKE_BINARY_DIR}/generated/forge-sanitize-cc" @ONLY)
    file(COPY "${CMAKE_BINARY_DIR}/generated/forge-sanitize-cc" DESTINATION "${CMAKE_BINARY_DIR}/bin"
        FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    set(FORGE_TEST_CC "${CMAKE_BINARY_DIR}/bin/forge-sanitize-cc")
endif()
