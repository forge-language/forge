@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(ForgeRuntime 0.3 CONFIG)
find_dependency(ForgeStd 0.3 CONFIG)
set_and_check(FORGE_ROOT_DIR "${PACKAGE_PREFIX_DIR}")
set_and_check(FORGE_BIN_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set_and_check(FORGE_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set_and_check(FORGE_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
if(NOT TARGET Forge::forge)
    add_executable(Forge::forge IMPORTED)
    set_target_properties(Forge::forge PROPERTIES IMPORTED_LOCATION "${FORGE_BIN_DIR}/forge${CMAKE_EXECUTABLE_SUFFIX}")
endif()
if(NOT TARGET Forge::forge_runtime)
    add_library(Forge::forge_runtime INTERFACE IMPORTED)
    set_property(TARGET Forge::forge_runtime PROPERTY INTERFACE_LINK_LIBRARIES ForgeRuntime::runtime)
endif()
if(NOT TARGET Forge::forge_std)
    add_library(Forge::forge_std INTERFACE IMPORTED)
    set_property(TARGET Forge::forge_std PROPERTY INTERFACE_LINK_LIBRARIES ForgeStd::stdlib)
endif()
set(FORGE_EXECUTABLE Forge::forge)
set(FORGE_RUNTIME_TARGET Forge::forge_runtime)
set(FORGE_BUILD_DEPS Forge::forge Forge::forge_runtime Forge::forge_std)
if(CMAKE_C_COMPILER)
    set(FORGE_CC_ARGS --cc "${CMAKE_C_COMPILER}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ForgeLibrary.cmake")
check_required_components(Forge)
