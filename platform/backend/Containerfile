FROM alpine:3.20 AS builder
RUN apk add --no-cache build-base cmake pkgconf postgresql-dev json-c-dev libmicrohttpd-dev curl-dev openssl-dev
WORKDIR /src
COPY . .
RUN sh platform/scripts/build.sh
FROM alpine:3.20
RUN apk add --no-cache libpq json-c libmicrohttpd libcurl openssl ca-certificates curl
WORKDIR /app
COPY --from=builder /src/platform/build/forge-backend /app/forge-backend
COPY platform/backend/migrations platform/backend/migrations
USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1
CMD ["/app/forge-backend"]
