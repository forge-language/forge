# Build
build/
# Sanitizer, benchmark and verification build trees, all cmake-generated.
build-*/
# CTest scratch directory.
Testing/
*.o
*.a

# OMC agent local state
.omc/

# Editor (keep shared workspace settings visible)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
benchmark/python/.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Elixir / Phoenix benchmark
benchmark/phoenix/**/_build/
benchmark/phoenix/**/deps/
benchmark/phoenix/**/.fetch
erl_crash.dump
.elixir_ls/

# Rust / Axum benchmark
benchmark/axum/**/target/

# Lean4 prover: elan/lake artifacts and generated benchmark instances
lean-prover/.lake/
lean-prover/bench/cnf/

# Benchmark output
benchmark/results.txt
benchmark/*.log

# Compiled benchmark servers and the load generator. Sources are tracked; the
# harness rebuilds each of these on every run, so the artifacts are not.
benchmark/c/bench_server
benchmark/go/server
benchmark/go/bench_server_go
benchmark/loadgen/loadgen
benchmark/erlang/*.beam
benchmark/concurrency/bin/

# oh-my-claudecode agent state (project-scoped skills are the exception)
/.omc/*
!/.omc/skills

# Claude Code local session state
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Local practice builds
practice/a.out
practice/*.o

# Lean 4 proofs
lean/.lake/
lean/lake-packages/
lean/build/

# Node / LSP
lsp/node_modules/
lsp/out/
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/server/
